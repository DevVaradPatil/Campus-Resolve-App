rules_version = '2';

// Deny by default. All writes go through server route handlers (Admin SDK bypasses these rules).
// Client reads are an explicit allowlist (see CLAUDE.md).
service cloud.firestore {
  match /databases/{database}/documents {
    function isActiveUser() {
      return request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.active == true;
    }

    // Public projection built only by toPublicComplaint(). Pages are capped at 20 (quota, PRD §8.3).
    match /publicComplaints/{id} {
      allow get: if isActiveUser();
      allow list: if isActiveUser() && request.query.limit <= 20;
    }

    // Your own notifications only, latest 20 at a time. Marking read goes through the API.
    match /notifications/{id} {
      allow get: if isActiveUser() && resource.data.recipientUid == request.auth.uid;
      allow list: if isActiveUser()
        && resource.data.recipientUid == request.auth.uid
        && request.query.limit <= 20;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
