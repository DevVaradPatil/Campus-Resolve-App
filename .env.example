# Copy to .env.local and fill in. Never commit real values. See TODO.md for where each comes from.

# --- Local development against the Firebase emulators (no real project needed) ---
# Set to "true" to point the client and Admin SDKs at the local emulators started by `npm run emulators`.
NEXT_PUBLIC_USE_EMULATORS=true

# --- Firebase web app config (public, safe in client bundle) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-campusresolve
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin service account (server only) ---
# Not needed when using emulators. FIREBASE_PRIVATE_KEY keeps its \n escapes; paste it in double quotes.
FIREBASE_PROJECT_ID=demo-campusresolve
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- Cloudflare R2 (server only, Phase 3) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# --- App secrets (server only, Phase 2+) ---
ACTIVATION_CODE_PEPPER=
RATE_LIMIT_IP_SALT=
CRON_SECRET=

# --- Phase 7 ---
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
SENTRY_DSN=
